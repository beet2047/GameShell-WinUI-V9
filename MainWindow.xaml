<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GameShell_WinUI_V9.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GameShell_WinUI_V9"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="GameShell">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid Grid.Column="0" Padding="12,16,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="🎮 GameShell" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="Dashboard personal" FontSize="12" Opacity="0.6"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="6" Margin="0,0,0,12">
                <Button x:Name="BtnAddGame" Content="＋ Agregar juego"
                        HorizontalAlignment="Stretch" Click="BtnAddGame_Click"/>
                <Button x:Name="BtnDeleteGame" Content="🗑 Eliminar juego"
                        HorizontalAlignment="Stretch" Click="BtnDeleteGame_Click"/>
                <Button x:Name="BtnGameProps" Content="⚙ Propiedades"
                        HorizontalAlignment="Stretch" Click="BtnGameProps_Click"/>
                <Button x:Name="BtnManualTimer" Content="⏱ Cronómetro manual"
                        HorizontalAlignment="Stretch" Visibility="Collapsed"
                        Click="BtnManualTimer_Click"/>
            </StackPanel>

            <AutoSuggestBox Grid.Row="2" x:Name="SearchBox"
                            PlaceholderText="Buscar juego..."
                            QueryIcon="Find"
                            Margin="0,0,0,8"
                            TextChanged="SearchBox_TextChanged"/>

            <ListView Grid.Row="3" x:Name="GameListView"
                      SelectionChanged="GameListView_SelectionChanged"
                      SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" Padding="4,6"/>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Main panel -->
        <Grid Grid.Column="1" Padding="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tarjetas sistema -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="8" Padding="12,10" Margin="0,0,8,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="CPU" FontSize="11" Opacity="0.6"/>
                        <TextBlock x:Name="LblCpu" Text="0%" FontSize="24" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" CornerRadius="8" Padding="12,10" Margin="0,0,8,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="RAM" FontSize="11" Opacity="0.6"/>
                        <TextBlock x:Name="LblRam" Text="0%" FontSize="24" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" CornerRadius="8" Padding="12,10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="DISCO" FontSize="11" Opacity="0.6"/>
                        <TextBlock x:Name="LblDisk" Text="0%" FontSize="24" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Juego seleccionado -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Portada — Uniform sin recorte -->
                <Border Grid.Column="0" CornerRadius="8" Margin="0,0,12,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        Height="120">
                    <Image x:Name="GameCover" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock x:Name="LblGameName" Text="—" FontSize="20" FontWeight="Bold"/>
                    <TextBlock x:Name="LblGameTime" Text="Tiempo total: —" Opacity="0.7"/>
                    <TextBlock x:Name="LblLastPlayed" Text="Última sesión: —" Opacity="0.5" FontSize="12"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button x:Name="BtnLaunch" Content="▶ Lanzar"
                                IsEnabled="False" Click="BtnLaunch_Click"/>
                        <Button x:Name="BtnStopTimer" Content="⏹ Detener cronómetro"
                                Visibility="Collapsed" Click="BtnStopTimer_Click"/>
                        <TextBlock x:Name="LblStatus" VerticalAlignment="Center"
                                   Opacity="0.7" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Tabs -->
            <TabView Grid.Row="2" IsAddTabButtonVisible="False">
                <TabViewItem Header="Últimas sesiones" IsClosable="False">
                    <ListView x:Name="SessionListView">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="16" Padding="4,6">
                                    <TextBlock Text="{Binding Date}" Width="140" Opacity="0.8"/>
                                    <TextBlock Text="{Binding Duration}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </TabViewItem>

                <TabViewItem Header="Estadísticas" IsClosable="False">
                    <StackPanel Padding="16" Spacing="16">
                        <Border CornerRadius="8" Padding="16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Tiempo total jugado" FontSize="11" Opacity="0.6"/>
                                <TextBlock x:Name="LblStatTotal" FontSize="22" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="8" Padding="16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Juego más jugado" FontSize="11" Opacity="0.6"/>
                                <TextBlock x:Name="LblStatMost" FontSize="18" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="8" Padding="16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Días activos" FontSize="11" Opacity="0.6"/>
                                <TextBlock x:Name="LblStatDays" FontSize="22" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabViewItem>

                <TabViewItem Header="Actividad" IsClosable="False">
                    <Grid Padding="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" x:Name="ActivityGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Stretch"
                                        Margin="0,0,8,0" Width="40">
                                <TextBlock x:Name="LblYMax" Text="0m" FontSize="10" Opacity="0.6" VerticalAlignment="Top"/>
                                <TextBlock x:Name="LblYMid" Text="0m" FontSize="10" Opacity="0.6" VerticalAlignment="Center"/>
                                <TextBlock Text="0m" FontSize="10" Opacity="0.6" VerticalAlignment="Bottom"/>
                            </StackPanel>

                            <Grid Grid.Column="1" x:Name="BarContainer">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" x:Name="BarLun" VerticalAlignment="Bottom"
                                        CornerRadius="4,4,0,0" Margin="4,0"
                                        Background="{ThemeResource SystemAccentColor}" Height="0"/>
                                <Border Grid.Column="1" x:Name="BarMar" VerticalAlignment="Bottom"
                                        CornerRadius="4,4,0,0" Margin="4,0"
                                        Background="{ThemeResource SystemAccentColor}" Height="0"/>
                                <Border Grid.Column="2" x:Name="BarMie" VerticalAlignment="Bottom"
                                        CornerRadius="4,4,0,0" Margin="4,0"
                                        Background="{ThemeResource SystemAccentColor}" Height="0"/>
                                <Border Grid.Column="3" x:Name="BarJue" VerticalAlignment="Bottom"
                                        CornerRadius="4,4,0,0" Margin="4,0"
                                        Background="{ThemeResource SystemAccentColor}" Height="0"/>
                                <Border Grid.Column="4" x:Name="BarVie" VerticalAlignment="Bottom"
                                        CornerRadius="4,4,0,0" Margin="4,0"
                                        Background="{ThemeResource SystemAccentColor}" Height="0"/>
                                <Border Grid.Column="5" x:Name="BarSab" VerticalAlignment="Bottom"
                                        CornerRadius="4,4,0,0" Margin="4,0"
                                        Background="{ThemeResource SystemAccentColor}" Height="0"/>
                                <Border Grid.Column="6" x:Name="BarDom" VerticalAlignment="Bottom"
                                        CornerRadius="4,4,0,0" Margin="4,0"
                                        Background="{ThemeResource SystemAccentColor}" Height="0"/>
                            </Grid>
                        </Grid>

                        <Grid Grid.Row="1" Margin="48,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Lun" FontSize="11" Opacity="0.6" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Mar" FontSize="11" Opacity="0.6" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Mié" FontSize="11" Opacity="0.6" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="Jue" FontSize="11" Opacity="0.6" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="Vie" FontSize="11" Opacity="0.6" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="Sáb" FontSize="11" Opacity="0.6" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="6" Text="Dom" FontSize="11" Opacity="0.6" HorizontalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </TabViewItem>
            </TabView>
        </Grid>
    </Grid>
</Window>